---
interface Props {
	/** Contact page draws its own top rule above the footer. */
	bordered?: boolean;
}

const { bordered = false } = Astro.props;
---

<footer class:list={['footer', { bordered }]}>
	<span class="flogo">Pilot<span>Lab</span></span>
	<div class="flinks">
		<a href="/services">Services</a>
		<a href="/lab">Lab</a>
		<a href="/insights">Insights</a>
		<a href="/about">About</a>
		<a href="/contact">Contact</a>
	</div>
	<span>© 2026 PilotLab</span>
</footer>

<style>
	.footer {
		display: grid;
		grid-template-columns: minmax(140px, 1fr) auto minmax(140px, 1fr);
		align-items: center;
		gap: 24px;
		max-width: 1440px;
		margin: 0 auto;
		width: 100%;
		padding: 34px 32px;
		font-size: 13px;
		color: var(--muted);
	}
	.footer > span:last-child {
		justify-self: end;
		white-space: nowrap;
	}
	.footer.bordered {
		border-top: 1px solid var(--hairline);
	}
	.flogo {
		font-family: var(--sora);
		font-weight: 400;
		font-size: 21px;
		color: var(--ink);
	}
	.flogo span {
		color: var(--blue);
	}
	.flinks {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px 28px;
		font-weight: 500;
		font-size: 13px;
	}
	@media (max-width: 760px) {
		.footer {
			grid-template-columns: 1fr;
			justify-items: start;
			gap: 16px;
			padding: 24px 20px;
		}
		.footer > span:last-child {
			justify-self: start;
		}
		.flinks {
			justify-content: flex-start;
			gap: 12px 22px;
		}
	}
</style>
