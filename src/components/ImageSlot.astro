---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Fills its positioned parent with imagery. With `src` it renders an
 * optimized image (label becomes the alt text); without, the handoff-style
 * crosshatch placeholder.
 */
interface Props {
	label: string;
	src?: ImageMetadata;
}

const { label, src } = Astro.props;
---

{
	src ? (
		<Image
			class="img"
			src={src}
			alt={label}
			widths={[640, 1024, 1440, 1920]}
			sizes="(max-width: 900px) 100vw, 60vw"
		/>
	) : (
		<div class="slot" role="img" aria-label={label}>
			<span>{label}</span>
		</div>
	)
}

<style>
	.img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* mockups are content-heavy at the top — crop from the bottom */
		object-position: center top;
	}
	.slot {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background:
			repeating-linear-gradient(45deg, rgba(14, 28, 51, 0.05) 0 1.5px, transparent 1.5px 14px),
			#e3e8f0;
	}
	.slot span {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
		padding: 8px 14px;
		border: 1.5px solid var(--hairline);
		background: rgba(238, 241, 246, 0.7);
		text-align: center;
		max-width: 80%;
	}
</style>
