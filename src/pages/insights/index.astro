---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { articles } from '../../data/articles';
import { breadcrumbSchema, organizationSchema } from '../../data/site';

const siteUrl = Astro.site!.href.replace(/\/$/, '');
---

<Layout
	title="Insights — Software Development & AI Automation | PilotLab"
	description="Practical field notes on software development, platform engineering, AI integration, workflow automation, and building digital products that last."
	schema={[
		organizationSchema(siteUrl),
		breadcrumbSchema(siteUrl, [
			{ name: 'Home', path: '/' },
			{ name: 'Insights', path: '/insights' },
		]),
	]}
>
	<Nav active="insights" />
	<main>
		<section class="hero">
			<p class="eyebrow">PilotLab / Insights</p>
			<h1>Useful ideas<br /><span class="accent">for building.</span></h1>
			<p class="intro">Practical notes on software development, platform engineering, and AI systems that help teams ship with more clarity.</p>
		</section>
		<section class="article-list">
			{articles.map((article) => (
				<a class="article-card" href={`/insights/${article.slug}`}>
					<div class="article-meta"><span>{article.category}</span><span>{article.readTime}</span></div>
					<h2>{article.title}</h2>
					<p>{article.dek}</p>
					<span class="read">Read the field note →</span>
				</a>
			))}
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.hero { padding: 72px 48px 64px; border-bottom: 1.5px solid var(--ink); }
	.eyebrow { color: var(--blue); font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
	.hero h1 { margin-top: 24px; font-family: var(--sora); font-size: clamp(50px, 8.1vw, 104px); line-height: .98; font-weight: 800; letter-spacing: -.04em; text-transform: uppercase; }
	.accent { color: var(--blue); }
	.intro { max-width: 620px; margin-top: 32px; color: var(--body); font-size: 19px; line-height: 1.65; text-wrap: pretty; }
	.article-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding: 48px; }
	.article-card { display: flex; flex-direction: column; min-height: 330px; padding: 32px; border: 1.5px solid var(--ink); color: inherit; transition: transform .25s, background .25s, color .25s; }
	.article-card:hover { background: var(--ink); color: #fff; transform: translateY(-5px); }
	.article-meta { display: flex; justify-content: space-between; gap: 16px; color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.article-card h2 { max-width: 620px; margin-top: 46px; font-family: var(--sora); font-size: clamp(25px, 3vw, 38px); line-height: 1.08; letter-spacing: -.03em; }
	.article-card p { max-width: 560px; margin-top: 18px; color: var(--body); font-size: 16px; line-height: 1.65; }
	.article-card:hover p { color: #dbe4f5; }
	.read { margin-top: auto; padding-top: 28px; font-size: 14px; font-weight: 700; }
	@media (max-width: 900px) { .hero, .article-list { padding-left: 20px; padding-right: 20px; } .article-list { grid-template-columns: 1fr; } }
</style>
