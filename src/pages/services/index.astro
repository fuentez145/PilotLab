---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { services } from '../../data/services';
import { breadcrumbSchema, organizationSchema } from '../../data/site';

const marquee = ['Fixed scope', 'Weekly demos', 'You own the code', 'A month on call, free'];
const siteUrl = Astro.site!.href.replace(/\/$/, '');
---

<Layout
	title="Services — Web Apps, E-commerce & Marketing Sites | PilotLab"
	description="Four fixed-scope ways to work with PilotLab: web applications, e-commerce storefronts, marketing sites, and rescue & performance. Weekly demos. You own the code."
	schema={[
		organizationSchema(siteUrl),
		breadcrumbSchema(siteUrl, [
			{ name: 'Home', path: '/' },
			{ name: 'Services', path: '/services' },
		]),
		{
			'@type': 'ItemList',
			name: 'PilotLab services',
			itemListElement: services.map((s, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: s.name,
				url: `${siteUrl}/services/${s.slug}`,
			})),
		},
	]}
>
	<Nav active="services" />

	<main>

	<section class="hero">
		<h1 data-rv>The <span class="accent">services</span></h1>
		<p data-rv>
			Four ways to work together. Every engagement is fixed-scope, quoted in writing, and
			delivered with weekly live demos — you always know exactly where things stand.
		</p>
	</section>

	{
		services.map((s) => (
			<section data-rv class="svc">
				<div class="svc-main">
					<div class="svc-n">{s.n}</div>
					<h2>{s.name}</h2>
					<p>{s.desc}</p>
					<a href={`/services/${s.slug}`} class="explore">
						See scope & process →
					</a>
				</div>
				<div class="svc-side">
					<div class="side-label">What you get</div>
					<div class="side-list">
						{s.items.map((it) => (
							<div class="side-item">
								<span class="diamond">◆</span>
								<span class="side-text">{it}</span>
							</div>
						))}
					</div>
				</div>
			</section>
		))
	}

	<div class="marquee" aria-hidden="true">
		<div class="marquee-track">
			{[0, 1].map(() => marquee.map((m) => <><span>{m}</span><span>◆</span></>))}
		</div>
	</div>

	<section class="cta">
		<h2 data-rv>Not sure which fits?<br /><a href="/contact">Just ask →</a></h2>
	</section>

	</main>

	<Footer />
</Layout>

<style>
	.hero {
		padding: 72px 48px 48px;
		border-bottom: 1.5px solid var(--ink);
	}
	.hero h1 {
		font-family: var(--sora);
		font-size: clamp(50px, 8.125vw, 104px);
		line-height: 0.98;
		font-weight: 800;
		letter-spacing: -0.04em;
		text-transform: uppercase;
	}
	.accent {
		color: var(--blue);
	}
	.hero p {
		font-size: 19px;
		line-height: 1.6;
		max-width: 560px;
		margin-top: 32px;
		color: var(--body);
		text-wrap: pretty;
	}

	.svc {
		display: grid;
		grid-template-columns: 1.1fr minmax(0, 1fr);
		border-bottom: 1.5px solid var(--ink);
	}
	.svc-main {
		padding: 64px 48px;
		border-right: 1.5px solid var(--ink);
	}
	.svc-n {
		font-family: var(--sora);
		font-size: 14px;
		font-weight: 700;
		color: var(--blue);
		margin-bottom: 20px;
	}
	.svc-main h2 {
		font-family: var(--sora);
		font-size: clamp(28px, 3.4vw, 44px);
		line-height: 1.05;
		font-weight: 800;
		letter-spacing: -0.03em;
		text-transform: uppercase;
	}
	.svc-main p {
		font-size: 17px;
		line-height: 1.7;
		color: var(--body);
		max-width: 480px;
		margin-top: 22px;
		text-wrap: pretty;
	}
	.explore {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin-top: 34px;
		padding: 13px 26px;
		border: 1.5px solid var(--ink);
		font-family: var(--sora);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		transition: all 0.2s;
	}
	.explore:hover {
		background: var(--ink);
		color: #fff;
	}
	.svc-side {
		padding: 64px 48px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.side-label {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 20px;
	}
	.side-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.side-item {
		display: flex;
		align-items: baseline;
		gap: 14px;
		border-bottom: 1.5px solid rgba(14, 28, 51, 0.15);
		padding-bottom: 14px;
	}
	.diamond {
		font-family: var(--sora);
		font-size: 13px;
		font-weight: 700;
		color: var(--blue);
	}
	.side-text {
		font-size: 15.5px;
		line-height: 1.5;
		color: var(--body);
	}

	.marquee {
		border-bottom: 1.5px solid var(--ink);
		padding: 18px 0;
		overflow: hidden;
		background: var(--blue);
	}
	.marquee-track {
		display: flex;
		gap: 56px;
		width: max-content;
		animation: plMarquee 22s linear infinite;
		font-family: var(--sora);
		font-weight: 700;
		font-size: 16px;
		color: #fff;
		white-space: nowrap;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.cta {
		padding: 96px 48px;
		border-bottom: 1.5px solid var(--ink);
	}
	.cta h2 {
		font-family: var(--sora);
		font-size: clamp(40px, 6.875vw, 88px);
		line-height: 1;
		font-weight: 800;
		letter-spacing: -0.04em;
		text-transform: uppercase;
	}
	.cta a {
		color: var(--blue);
	}
	.cta a:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.hero,
		.svc-main,
		.svc-side,
		.cta {
			padding-left: 20px;
			padding-right: 20px;
		}
		.svc {
			grid-template-columns: 1fr;
		}
		.svc-main {
			border-right: none;
			border-bottom: 1.5px solid var(--hairline);
			padding-bottom: 44px;
		}
		.svc-side {
			padding-top: 44px;
		}
	}
</style>
